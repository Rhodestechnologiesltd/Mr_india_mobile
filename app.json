{
  "expo": {
    "name": "Mr India",
    "slug": "mrindia54",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/logos/Mr India Logo mobile.png",
    "scheme": "mrindia54",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/logos/Mr India Logo mobile.png",
      "bundleIdentifier": "mu.mrindia.test",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocalNetworkUsageDescription": "Mr India needs access to your local network to connect to the development server.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/logos/Mr India Logo mobile.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.mrindia54"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-image",
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.197641837033-j0i31ou4d4lk916cu5m9lg59555l8ci4"
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "18bff656-22f8-44fd-aff6-e1e5a533c7bd"
      }
    }
  }
}



